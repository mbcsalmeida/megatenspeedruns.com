---
import { Image } from 'astro:assets';

const {
    title,
    description,
    imagePath,
    alt = 'Background Image', 
    ...attributes
  } = Astro.props;

---

<div class="sl-link-card">
    <Image
    src={imagePath},
    alt={alt},
    class="background"
    />
    <span class="sl-flex stack">
        <a {...attributes}>
            <span class="title" set:html={title} />
        </a>
        {description && <span class="description" set:html={description} />}
    </span>
</div>

<style>
    .sl-link-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
    padding: 5rem;
    box-shadow: var(--sl-shadow-sm);
    position: relative;
    text-align: center;
    transition: transform 0.3s ease;
    }

    .background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100% !important;
    background-size: cover;
    background-position: center;
    overflow: hidden;
    z-index: -1;
    opacity: 0.4; /* Adjust for visibility */
    object-fit: cover;
    }

    a {
    text-decoration: none;
    line-height: var(--sl-line-height-headings);
    }

    /* a11y fix for https://github.com/withastro/starlight/issues/487 */
    a::before {
    content: '';
    position: absolute;
    inset: 0;
    }

    .stack {
    flex-direction: column;
    gap: 0.5rem;
    }

    .title {
    color: white;
    font-weight: 600;
    font-size: var(--sl-text-lg);
    text-transform: uppercase;
    text-shadow: #474747 3px 5px 2px, 1px -1px 1px rgba(0,0,0,0), 1px -1px 1px rgba(0,0,0,0);
    }

    .description {
    color: white;
    line-height: 1.5;
    text-shadow: #474747 3px 5px 2px, 1px -1px 1px rgba(0,0,0,0), 1px -1px 1px rgba(0,0,0,0);
    }

    /* Hover state */
    .sl-link-card:hover {
    transform: scale(0.9);
    }

    .sl-link-card:hover > .background {
        opacity: 0.7;
    }
</style>